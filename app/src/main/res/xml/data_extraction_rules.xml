<?xml version="1.0" encoding="utf-8"?>
<!-- Backup + device-transfer rules (Android 12+). D1.5: the onboarding
     flag is excluded (both cloud and cable transfer) so a fresh start
     actually shows onboarding. Everything else still backs up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cura_onboarding.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cura_onboarding.xml" />
    </device-transfer>
</data-extraction-rules>
