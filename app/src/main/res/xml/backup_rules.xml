<?xml version="1.0" encoding="utf-8"?>
<!-- Full backup content (Android 8-11). D1.5: the onboarding flag lives in
     its own prefs file and is EXCLUDED so reinstalls and fresh devices
     greet the user with onboarding. Everything else still backs up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="cura_onboarding.xml" />
</full-backup-content>
